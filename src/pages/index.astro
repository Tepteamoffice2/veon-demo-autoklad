---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Pidbir from "../components/Pidbir.astro";
import Marky from "../components/Marky.astro";
import Katalog from "../components/Katalog.astro";
import Umovy from "../components/Umovy.astro";
import ProNas from "../components/ProNas.astro";
import Kontakty from "../components/Kontakty.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import { phones, email, stores, socials } from "../data/site";

const title = "Автозапчастини за VIN у Києві та по Україні | Автоклад";
const description = "Підбір автозапчастин за VIN по оригінальних каталогах. Два представництва в Києві, Нова пошта по Україні, більшість товарів без передоплати.";

const hoursSpec = [
  { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "10:00", closes: "19:00" },
  { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "15:00" },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "#org",
      name: "Автоклад",
      legalName: "ТОВ «Автоклад»",
      foundingDate: "2010",
      email,
      telephone: phones.map((p) => p.href.replace("tel:", "")),
      sameAs: socials.map((s) => s.href),
    },
    ...stores.map((s) => ({
      "@type": "AutoPartsStore",
      name: `Автоклад, ${s.district}`,
      parentOrganization: { "@id": "#org" },
      telephone: phones[0]!.href.replace("tel:", ""),
      address: { "@type": "PostalAddress", streetAddress: s.street, addressLocality: "Київ", addressCountry: "UA" },
      openingHoursSpecification: hoursSpec,
    })),
  ],
};
---
<Base lang="uk" title={title} description={description}>
  <script slot="head" type="application/ld+json" data-rec="SEO-R001,SEO-R003" set:html={JSON.stringify(jsonLd)} />
  <Header slot="header" />
  <Pidbir />
  <Marky />
  <Katalog />
  <Umovy />
  <ProNas />
  <Kontakty />
  <Fragment slot="footer">
    <Footer />
    <MobileBar />
  </Fragment>
</Base>
