---
import FutureLink from "./FutureLink.astro";
import { categories, SOON, TELEGRAM_BOT } from "../data/site";
import { asset } from "../lib/asset";
---
<section id="katalog" class="section katalog" data-rec="R-004" aria-labelledby="katalog-title">
  <div class="container">
    <div class="katalog__head">
      <h2 id="katalog-title">Що шукаєте: 12 розділів каталогу</h2>
      <p>Від оливи і фільтрів для ТО до кузова й оптики. Не впевнені, що саме потрібно? <a class="text-link" href={TELEGRAM_BOT} target="_blank" rel="noopener">Надішліть VIN менеджеру</a>, він підбере.</p>
    </div>
    <ol class="katalog__list">
      {categories.map((c, i) => (
        <li>
          <FutureLink note={SOON} class="katalog__row">
            <span class="katalog__n mono num">{String(i + 1).padStart(2, "0")}</span>
            <span class="katalog__name">{c.name}</span>
            <picture class="katalog__img">
              <source srcset={asset(`img/cat/${c.img}.avif`)} type="image/avif" />
              <source srcset={asset(`img/cat/${c.img}.webp`)} type="image/webp" />
              <img src={asset(`img/cat/${c.img}.webp`)} width="192" height="192" alt="" loading="lazy" decoding="async" />
            </picture>
          </FutureLink>
        </li>
      ))}
    </ol>
    <div class="katalog__extra">
      <FutureLink note={SOON} class="katalog__norms">Норми та періоди заміни</FutureLink>
      <span class="muted">Довідник періодів заміни для планового ТО</span>
    </div>
  </div>
</section>

<style>
  .katalog { background: var(--color-surface); border-block: var(--line); }
  .katalog__head { display: grid; gap: var(--s-2); margin-bottom: var(--s-4); }
  .katalog__head p { color: var(--color-text-muted); font-size: 1.125rem; max-width: 34rem; }
  .text-link { color: var(--color-field); font-weight: 600; text-underline-offset: 3px; }
  .text-link:hover { color: var(--color-field-deep); }

  .katalog__list { display: grid; grid-template-columns: minmax(0, 1fr); border-top: var(--line); }
  .katalog__list li { border-bottom: var(--line); }
  .katalog__list :global(.katalog__row) {
    display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) 3.5rem; align-items: center; gap: var(--s-2);
    width: 100%; min-height: 4.25rem; padding-block: .5rem;
    transition: background-color 120ms var(--ease-out);
  }
  .katalog__list :global(.katalog__row:active) { background: var(--color-scrim); }
  .katalog__n { font-size: .8125rem; color: var(--color-text-muted); }
  .katalog__name { position: relative; justify-self: start; font-size: var(--fs-title); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .katalog__name::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 2px; background: var(--color-field);
    transform: scaleX(0); transform-origin: left; transition: transform 220ms var(--ease-out);
  }
  .katalog__list :global(.katalog__row:hover) .katalog__name,
  .katalog__list :global(.katalog__row:focus-visible) .katalog__name { color: var(--color-field); }
  .katalog__list :global(.katalog__row:hover) .katalog__name::after,
  .katalog__list :global(.katalog__row:focus-visible) .katalog__name::after { transform: scaleX(1); }
  .katalog__img { display: block; width: 3.5rem; height: 3.5rem; border-radius: var(--radius); overflow: hidden; background: var(--color-surface); }
  .katalog__img img { mix-blend-mode: multiply; }
  .katalog__img img { width: 100%; height: 100%; object-fit: contain; }

  .katalog__extra { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1rem; margin-top: var(--s-3); }
  .katalog__extra :global(.katalog__norms) { font-weight: 600; color: var(--color-field); text-decoration: underline; text-decoration-style: dashed; text-underline-offset: 4px; min-height: 2.75rem; }

  @media (min-width: 768px) {
    .katalog__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; gap: var(--s-4); }
    .katalog__head p { justify-self: end; }
    .katalog__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-4); border-top: 0; }
    .katalog__list li:nth-child(-n + 2) { border-top: var(--line); }
    .katalog__list :global(.katalog__row) { grid-template-columns: 2.5rem minmax(0, 1fr) 5rem; min-height: 6rem; }
    .katalog__img { width: 5rem; height: 5rem; }
  }
</style>
